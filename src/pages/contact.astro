---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact - Haryo Sudarman">
  <section class="hero">
    <p class="prompt">~ $ cat contact.md</p>
    <h1>Kontak</h1>
    <div class="prose">
      <p>
        Mau diskusi, kolaborasi, atau sekadar menyapa? Hubungi saya lewat:
      </p>
      <ul>
        <li>Email: <a href="mailto:hello@haryo.id">hello@haryo.id</a></li>
        <li>GitHub: <a href="https://github.com/" target="_blank" rel="noopener">github.com/username</a></li>
        <li>Twitter/X: <a href="https://twitter.com/" target="_blank" rel="noopener">@username</a></li>
      </ul>
      <p style="color: var(--muted); font-size: 0.9rem;">
        Ganti detail kontak di atas (<code>src/pages/contact.astro</code>) dengan info kamu.
      </p>
    </div>
  </section>
</BaseLayout>
