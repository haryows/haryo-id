  <section class="hero">
    <p class="prompt">~ $ cat contact.md</p>
    <h1>Kontak</h1>
    <div class="prose">
      <p>
        Mau diskusi, kolaborasi, atau sekadar menyapa? Hubungi saya lewat:
      </p>
      <ul>
        <li>Email: <a href="mailto:haryo.w.sudarman@gmail.com">haryo.w.sudarman@gmail.com</a></li>
        <li>GitHub: <a href="https://github.com/haryows" target="_blank" rel="noopener">github.com/haryows</a></li>
      </ul>
      <p style="color: var(--muted); font-size: 0.9rem;">
        Jangan sungkan ya, kalau ada artikel saya yang menyesatkan bisa hubungi saya.
      </p>
    </div>
  </section>
</BaseLayout>
