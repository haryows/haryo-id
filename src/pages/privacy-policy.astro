---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Privacy Policy - Haryo Sudarman">
  <section class="hero">
    <p class="prompt">~ $ cat privacy-policy.md</p>
    <h1>Privacy Policy</h1>
    <div class="prose">
      <p>
        Situs ini tidak mengumpulkan data pribadi pengunjung secara aktif selain
        analitik dasar (jika diaktifkan). Ganti halaman ini sesuai kebijakan privasi
        yang berlaku untuk situsmu.
      </p>
    </div>
  </section>
</BaseLayout>
